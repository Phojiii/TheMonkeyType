{
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"]
    },
    "skipLibCheck": true,
    "allowJs": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx"
  },
  "include": [
    "*.js",
    "*.json",
    "app/**/*",
    "components/**/*",
    "content/**/*",
    "lib/**/*",
    "models/**/*",
    "pages/**/*",
    "scripts/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".next"
  ]
}